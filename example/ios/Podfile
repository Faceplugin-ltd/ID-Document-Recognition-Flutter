# To learn about Flutter iOS setup, see https://docs.flutter.dev/deployment/ios
# After placing docsdk.framework, run: cd example/ios && pod install

require 'fileutils'

platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Ensure docsdk.xcframework exists for SwiftPM (built from docsdk.framework).
# Pure Ruby + xcodebuild — no bash (Windows never runs this Podfile).
# SPM Package.swift loads Frameworks/ under ios/document_reader_sdk/ (not ios/Frameworks/).
plugin_ios = File.expand_path('../../../ios', __dir__)
fw = File.join(plugin_ios, 'Frameworks', 'docsdk.framework')
xc = File.join(plugin_ios, 'Frameworks', 'docsdk.xcframework')
spm_fw_dir = File.join(plugin_ios, 'document_reader_sdk', 'Frameworks')
spm_xc = File.join(spm_fw_dir, 'docsdk.xcframework')
if File.directory?(fw)
  binary = File.join(fw, 'docsdk')
  plist = File.join(xc, 'Info.plist')
  needs_build = !File.directory?(xc) ||
                (File.exist?(binary) && File.exist?(plist) && File.mtime(binary) > File.mtime(plist)) ||
                (File.directory?(xc) && !File.exist?(plist))
  if needs_build
    FileUtils.rm_rf(xc) if File.exist?(xc)
    puts "Creating #{xc}"
    ok = system('xcodebuild', '-create-xcframework', '-framework', fw, '-output', xc)
    puts 'warning: xcodebuild -create-xcframework failed (SwiftPM may need docsdk.xcframework)' unless ok
  end
  if File.directory?(xc)
    FileUtils.mkdir_p(spm_fw_dir)
    # Real copy — SwiftPM binaryTarget often rejects symlinked xcframeworks.
    if !File.directory?(spm_xc) ||
       (File.exist?(plist) && File.exist?(File.join(spm_xc, 'Info.plist')) &&
        File.mtime(plist) > File.mtime(File.join(spm_xc, 'Info.plist'))) ||
       File.symlink?(spm_xc)
      FileUtils.rm_rf(spm_xc)
      FileUtils.cp_r(xc, spm_xc)
      puts "Synced SwiftPM binary → #{spm_xc}"
    end
  end
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # permission_handler: macros default to 0; without these, Permission.camera
      # never prompts and always reports denied.
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] unless defs.is_a?(Array)
      %w[
        PERMISSION_CAMERA=1
        PERMISSION_PHOTOS=1
      ].each do |flag|
        defs << flag unless defs.any? { |d| d.to_s.include?(flag.split('=').first) }
      end
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
    end
  end

  # Nested dcrcore inside docsdk must be re-signed with the app identity
  # (prepare.py ships it unsigned / ad-hoc; CodeSignOnCopy only seals outer docsdk).
  # Phase must run AFTER "[CP] Embed Pods Frameworks" or the embed overwrites the seal.
  # Always use SRCROOT so the committed pbxproj stays portable across machines.
  sign_script = "\"${SRCROOT}/scripts/sign_nested_docsdk.sh\"\n"

  installer.aggregate_targets.each do |aggregate_target|
    user_project = aggregate_target.user_project
    user_project.native_targets.each do |target|
      next unless target.product_type == 'com.apple.product-type.application'

      phase = target.shell_script_build_phases.find { |p| p.name == 'Sign nested dcrcore' }
      unless phase
        phase = target.new_shell_script_build_phase('Sign nested dcrcore')
        phase.run_only_for_deployment_postprocessing = '0'
      end
      phase.shell_script = sign_script

      # Xcode::Project keeps build_phases as an ordered list — move sign to last.
      target.build_phases.delete(phase)
      target.build_phases << phase
    end
    user_project.save
  end
end
